{
  "name": "tattico",
  "version": "0.1.0",
  "private": true,
  "description": "TATICO — Quadro tático de futebol 11v11 com acesso via MCP para IAs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @tattico/web",
    "dev:mcp": "npm run dev:both -w @tattico/mcp-server",
    "build": "npm run build -w @tattico/web && npm run build -w @tattico/mcp-server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "npm run smoke -w @tattico/mcp-server",
    "mcp": "node scripts/mcp-cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "@resvg/resvg-js@2.6.2": true,
    "esbuild@0.21.5": true
  }
}
